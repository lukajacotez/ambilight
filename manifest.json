{
  "manifest_version": 3,
  "name": "Ambilight by lowkyz",
  "version": "1.0.0",
  "description": "Personnalise la barre ambilight en bas de ton écran avec ta couleur préférée.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambilight"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
